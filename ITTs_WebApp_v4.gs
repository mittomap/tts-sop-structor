function doGet(){
  return HtmlService.createHtmlOutput(WA_HTML)
    .setTitle('ITTs - SOP TEMP')
    .addMetaTag('viewport','width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function waSS(){ return SpreadsheetApp.getActive(); }
function waSheet(pfx){ var shs=waSS().getSheets(); for(var i=0;i<shs.length;i++){ if(shs[i].getName().indexOf(pfx)===0) return shs[i]; } throw new Error('Khong tim thay sheet '+pfx); }
function waEcode(s){ s=String(s==null?'':s); var m=s.match(/^([^(]+?)\s*\(/); return m?m[1].trim():s.trim(); }
function waLink(sh,row){ return waSS().getUrl()+'#gid='+sh.getSheetId()+'&range=A'+row; }

var WA_SHEETS=['DL01','DL02','DL02b','DL03','DL04','DL05','DL06','DL07','DL08','DL09','DL10','DL11','DL12','DL13','DL14','DL15','DL16','DL17','DL18'];

function readSheet_(code){
  var sh; try{ sh=waSheet(code+'.'); }catch(e){ return []; }
  var last=sh.getLastRow(); if(last<4) return [];
  var lastCol=sh.getLastColumn();
  var hdr=sh.getRange(1,1,1,lastCol).getValues()[0].map(String);
  var disp=sh.getRange(4,1,last-3,lastCol).getDisplayValues();
  var out=[];
  for(var i=0;i<disp.length;i++){ if(String(disp[i][0])==='') continue; var o={}; for(var c=0;c<lastCol;c++){ if(hdr[c]) o[hdr[c]]=disp[i][c]; } out.push(o); }
  return out;
}
function readEnums_(){
  var ss=waSS(), nrs=ss.getNamedRanges(), out={};
  for(var i=0;i<nrs.length;i++){ var nm=nrs[i].getName(); if(nm.indexOf('enum_')===0){ try{ var vals=nrs[i].getRange().getValues().map(function(r){return String(r[0])}).filter(function(x){return x!==''}); out[nm]=vals; }catch(e){} } }
  return out;
}
var WA_PARAMS=['thresholdDiscount_approval','thresholdClassStart_days','thresholdAtRisk_absences','thresholdAtRisk_hw_missing','thresholdDeposit_minimum'];
function readParams_(){ var ss=waSS(), out={}; for(var i=0;i<WA_PARAMS.length;i++){ try{ var r=ss.getRangeByName(WA_PARAMS[i]); if(r) out[WA_PARAMS[i]]=r.getValue(); }catch(e){} } return out; }

function apiBootstrap(){
  var email=''; try{ email=Session.getActiveUser().getEmail()||''; }catch(e){}
  var me=null;
  try{
    var sh=waSheet('DL01.'); var last=sh.getLastRow();
    if(last>=4){
      var lastCol=sh.getLastColumn();
      var hdr=sh.getRange(1,1,1,lastCol).getValues()[0].map(String);
      var ie=hdr.indexOf('email'), is=hdr.indexOf('staff_id'), inm=hdr.indexOf('full_name'), ir=hdr.indexOf('role');
      var v=sh.getRange(4,1,last-3,lastCol).getValues();
      if(email && ie>=0){ for(var i=0;i<v.length;i++){ if(String(v[i][ie]||'').toLowerCase()===email.toLowerCase()){ me={staff_id:String(v[i][is]), full_name:String(v[i][inm]), roleCode:waEcode(v[i][ir])}; break; } } }
    }
  }catch(e){}
  return {ok:true, email:email, me:me};
}

function apiAllData(){ var dl={}; for(var i=0;i<WA_SHEETS.length;i++){ dl[WA_SHEETS[i]]=readSheet_(WA_SHEETS[i]); } return {dl:dl, enums:readEnums_(), params:readParams_(), config:readConfig_()}; }
function readConfig_(){
  var ch2=[]; try{ var sh=waSheet('CH2.'); var last=sh.getLastRow(); if(last>=6){ var v=sh.getRange(6,1,last-5,6).getValues(); for(var i=0;i<v.length;i++){ var a=v[i][0], b=v[i][1]; if(a!=='' && typeof b==='number'){ ch2.push({name:String(a).trim(), value:b, unit:String(v[i][2]||''), meaning:String(v[i][3]||''), suggested:String(v[i][5]||'')}); } } } }catch(e){}
  var ch6=[]; try{ var s6=waSheet('CH6.'); var l6=s6.getLastRow(); if(l6>=4){ var w=s6.getRange(4,1,l6-3,5).getValues(); for(var j=0;j<w.length;j++){ if(String(w[j][0]||'')==='') continue; ch6.push({code:String(w[j][0]).trim(), name:String(w[j][1]||''), threshold:w[j][2], dir:String(w[j][3]||''), phase:String(w[j][4]||'')}); } } }catch(e){}
  return {ch2:ch2, ch6:ch6};
}
function apiSetParam(name, value, meaning, unit){
  if(PERM_ENFORCE && currentRole_()!=='manager') return {ok:false, error:'Chi Quan ly / Giam doc duoc sua cau hinh (CH3).'};
  try{
    if(isNaN(Number(value))) return {ok:false, error:'Gia tri phai la so'};
    var v=Number(value);
    // 1) da co named range -> ghi thang
    var r=waSS().getRangeByName(name);
    if(r){ r.setValue(v); SpreadsheetApp.flush(); return {ok:true}; }
    // 2) co dong trong CH2 (cot A = ten) -> ghi vao cot B
    var sh=waSheet('CH2.');
    var last=sh.getLastRow();
    if(last>=6){
      var col=sh.getRange(6,1,last-5,1).getValues();
      for(var i=0;i<col.length;i++){
        if(String(col[i][0]||'').trim()===name){
          var row=6+i; sh.getRange(row,2).setValue(v);
          try{ waSS().setNamedRange(name, sh.getRange(row,2)); }catch(e2){}
          SpreadsheetApp.flush(); return {ok:true};
        }
      }
    }
    // 3) chua co -> THEM DONG MOI vao cuoi CH2 + dat named range
    var nr=Math.max(6,last+1);
    sh.getRange(nr,1).setValue(name);
    sh.getRange(nr,2).setValue(v);
    if(unit)    sh.getRange(nr,3).setValue(String(unit));
    if(meaning) sh.getRange(nr,4).setValue(String(meaning));
    try{ waSS().setNamedRange(name, sh.getRange(nr,2)); }catch(e3){}
    SpreadsheetApp.flush();
    return {ok:true, created:true};
  }catch(e){ return {ok:false, error:String(e&&e.message||e)}; }
}

/* ===== SỬA DANH MỤC (enum trong CH1) =====
   Thêm giá trị = chèn 1 dòng BÊN TRONG vùng named range -> Sheets tự nới vùng,
   nhờ đó ô Kiểm tra dữ liệu ở các sheet DL cũng tự có lựa chọn mới. */
/* ===== TAI LEN CHUNG TU (bien lai, anh chup Zalo...) -> Drive ===== */
function waFolder_(){
  var name='ITTs - Chứng từ';
  var it=DriveApp.getFoldersByName(name);
  if(it.hasNext()) return it.next();
  return DriveApp.createFolder(name);
}
function apiUpload(name, mime, b64){
  try{
    if(!b64) return {ok:false, error:'Khong co du lieu file'};
    var blob=Utilities.newBlob(Utilities.base64Decode(b64), mime||'application/octet-stream', name||'chungtu');
    var f=waFolder_().createFile(blob);
    try{ f.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); }catch(e){}
    return {ok:true, url:f.getUrl(), name:f.getName()};
  }catch(e){ return {ok:false, error:String(e&&e.message||e)}; }
}

function enumGuard_(){
  if(PERM_ENFORCE && currentRole_()!=='manager') return 'Chi Quan ly / Giam doc duoc sua danh muc (CH3).';
  return '';
}
function apiEnumSet(name, idx, value){
  var g=enumGuard_(); if(g) return {ok:false, error:g};
  try{
    var r=waSS().getRangeByName(name); if(!r) return {ok:false, error:'Khong thay danh muc '+name};
    if(idx<0 || idx>=r.getNumRows()) return {ok:false, error:'Vi tri khong hop le'};
    r.getCell(idx+1,1).setValue(String(value));
    SpreadsheetApp.flush(); return {ok:true};
  }catch(e){ return {ok:false, error:String(e&&e.message||e)}; }
}
function apiEnumAdd(name, value){
  var g=enumGuard_(); if(g) return {ok:false, error:g};
  try{
    var r=waSS().getRangeByName(name); if(!r) return {ok:false, error:'Khong thay danh muc '+name};
    var sh=r.getSheet(), row=r.getRow(), n=r.getNumRows(), col=r.getColumn();
    // chèn TRƯỚC dòng cuối của vùng -> vùng tự dài thêm 1
    sh.insertRowBefore(row+n-1);
    sh.getRange(row+n-1, col).setValue(String(value));
    SpreadsheetApp.flush();
    return {ok:true};
  }catch(e){ return {ok:false, error:String(e&&e.message||e)}; }
}
/* Doi gia tri enum trong DU LIEU: pairs=[[sheetCode, field],...]
   Chi doi o nao dang co ma = fromCode. Giu nguyen cong thuc o cac o khac. */
function apiEnumMigrate(pairs, fromCode, toValue){
  var g=enumGuard_(); if(g) return {ok:false, error:g};
  try{
    var total=0, detail=[];
    for(var p=0;p<pairs.length;p++){
      var code=pairs[p][0], field=pairs[p][1];
      var sh; try{ sh=waSheet(code+'.'); }catch(e){ continue; }
      var last=sh.getLastRow(); if(last<4) continue;
      var lastCol=sh.getLastColumn();
      var hdr=sh.getRange(1,1,1,lastCol).getValues()[0].map(String);
      var ci=hdr.indexOf(field); if(ci<0) continue;
      var n=last-3;
      var rg=sh.getRange(4,ci+1,n,1);
      var disp=rg.getDisplayValues(), vals=rg.getValues(), fml=rg.getFormulas();
      var out=[], cnt=0;
      for(var r=0;r<n;r++){
        if(waEcode(disp[r][0])===fromCode){ out.push([toValue]); cnt++; }
        else out.push([ fml[r][0] ? fml[r][0] : vals[r][0] ]);
      }
      if(cnt>0){ rg.setValues(out); total+=cnt; detail.push(code+'.'+field+': '+cnt); }
    }
    SpreadsheetApp.flush();
    return {ok:true, n:total, detail:detail};
  }catch(e){ return {ok:false, error:String(e&&e.message||e)}; }
}
function apiEnumDel(name, idx){
  var g=enumGuard_(); if(g) return {ok:false, error:g};
  try{
    var r=waSS().getRangeByName(name); if(!r) return {ok:false, error:'Khong thay danh muc '+name};
    var n=r.getNumRows(); if(n<=1) return {ok:false, error:'Phai con it nhat 1 gia tri'};
    if(idx<0 || idx>=n) return {ok:false, error:'Vi tri khong hop le'};
    r.getSheet().deleteRow(r.getRow()+idx);
    SpreadsheetApp.flush(); return {ok:true};
  }catch(e){ return {ok:false, error:String(e&&e.message||e)}; }
}

var WA_LINK={assigned_to:'DL01. Nhân viên', lead_id:'DL02. Khách tiềm năng', student_id:'DL09. Học viên', course_id:'DL05. Khóa học', class_id:'DL10. Lớp học', enrollment_id:'DL06. Đăng ký', consultation_id:'DL04. Tư vấn'};
var WA_IDP={DL01:['NV',3],DL02:['L-2026-',5],DL02b:['TP-',4],DL03:['TB-2026-',3],DL04:['CS-2026-',3],DL06:['ENR-2026-',3],DL07:['PAY-2026-',3],DL08:['OB-',3],DL09:['HV',3],DL12:['ATT-',4],DL13:['HW-',4],DL14:['WOW-',3],DL16:['FB-',3],DL17:['KN-2026-',3],DL18:['CE-',3]};
var WA_STAMP={DL03:[['test_status',['graded'],'result_time']],DL04:[['conversion_status',['*'],'conversion_time']],DL08:[['class_confirmation_status',['confirmed'],'confirmation_time'],['onboarding_status',['completed'],'onboarding_completed_at']],DL12:[['attendance_status',['on_time','late'],'check_in_time']],DL13:[['homework_status',['submitted'],'homework_submitted_time'],['homework_score',['*'],'graded_at']],DL16:[['feedback_status',['in_progress','resolved'],'classified_at'],['feedback_status',['resolved'],'action_taken_at']],DL17:[['assigned_handler',['*'],'assigned_at'],['complaint_status',['resolved'],'resolution_time']],DL18:[['re_enrollment_status',['*'],'re_enrollment_contact_time']]};

function waLinkF_(sheetName, code){ code=String(code).replace(/"/g,''); return '=IFERROR(HYPERLINK("#\''+sheetName+'\'!A"&MATCH("'+code+'",\''+sheetName+'\'!A:A,0),"'+code+'"),"'+code+'")'; }
function waCoerce_(k, v){
  if(/_time$|_date$|_at$|^dob$/.test(k)){ var d=new Date(v); if(!isNaN(d.getTime()) && String(v).match(/\d/)) return d; }
  if(/amount|fee|score|band|count|quota|_rate|price/.test(k)){ var s=String(v).replace(/[^0-9.\-]/g,''); if(s!=='' && !isNaN(Number(s))) return Number(s); }
  return v;
}
function waGenId_(code, colA){ var cfg=WA_IDP[code]; var mx=0; for(var i=0;i<colA.length;i++){ var m=String(colA[i][0]||'').match(/(\d+)\s*$/); if(m) mx=Math.max(mx,parseInt(m[1],10)); } var n=mx+1; if(!cfg) return code+'-'+n; return cfg[0]+('000000'+n).slice(-cfg[1]); }

var PERM_ENFORCE=false;
var PERM={DL02:['sales','manager','wow'],DL02b:['sales','manager'],DL03:['sales','wow','manager'],DL04:['sales','manager'],DL06:['sales','manager'],DL07:['sales','accountant','manager'],DL08:['academic','manager'],DL12:['teacher','academic','manager'],DL13:['teacher','manager'],DL14:['wow','manager'],DL15:['academic','manager'],DL16:['academic','manager'],DL17:['academic','manager'],DL18:['academic','manager'],DL09:['academic','sales','manager'],DL10:['academic','manager']};
function mapRoleServer_(c){c=String(c||'');if(/_manager|ceo/.test(c))return'manager';if(/sales/.test(c))return'sales';if(/wow/.test(c))return'wow';if(/academic/.test(c))return'academic';if(c==='teacher')return'teacher';if(/account/.test(c))return'accountant';return'manager';}
function currentRole_(){ var email=''; try{email=Session.getActiveUser().getEmail()||'';}catch(e){} if(!email) return 'manager';
  try{ var sh=waSheet('DL01.'); var last=sh.getLastRow(); if(last<4) return 'manager'; var lc=sh.getLastColumn(); var hdr=sh.getRange(1,1,1,lc).getValues()[0].map(String); var ie=hdr.indexOf('email'), ir=hdr.indexOf('role'); var v=sh.getRange(4,1,last-3,lc).getValues(); for(var i=0;i<v.length;i++){ if(String(v[i][ie]||'').toLowerCase()===email.toLowerCase()) return mapRoleServer_(waEcode(v[i][ir])); } }catch(e){}
  return 'manager'; /* email khong khop DL01 -> coi la admin (nen gioi han truy cap app trong to chuc khi deploy) */ }
function canWrite_(code){ if(!PERM_ENFORCE) return true; var role=currentRole_(); var allow=PERM[code]; if(!allow) return role==='manager'; return allow.indexOf(role)>=0; }
function apiSave(code, values){
  var lock=LockService.getDocumentLock(); try{ lock.waitLock(20000); }catch(e){ return {ok:false, error:'He thong dang ban, thu lai.'}; }
  try{
    if(!canWrite_(code)) return {ok:false,error:'Vai tro cua ban khong duoc phep ghi muc nay (CH3).'};
    var _sv=waValidate_(values); if(_sv) return {ok:false,error:_sv};
    var sh=waSheet(code+'.'); var lastCol=sh.getLastColumn(); var maxR=sh.getMaxRows();
    var hdr=sh.getRange(1,1,1,lastCol).getValues()[0].map(String);
    var tf=sh.getRange(4,1,1,lastCol).getFormulas()[0];
    var na=maxR-3; if(na<1) na=1;
    var colA=sh.getRange(4,1,na,1).getValues();
    var row=-1; for(var i=0;i<colA.length;i++){ if(String(colA[i][0])===''){ row=i+4; break; } }
    if(row<0){ row=4; for(var j=colA.length-1;j>=0;j--){ if(String(colA[j][0])!==''){ row=j+5; break; } } }
    var prev=row-1;
    if(prev>=4){ var pf=sh.getRange(prev,1,1,lastCol).getFormulas()[0]; for(var c=0;c<lastCol;c++){ if(pf[c]) sh.getRange(prev,c+1).copyTo(sh.getRange(row,c+1)); } }
    var id=waGenId_(code,colA);
    sh.getRange(row,1).setValue(id);
    for(var k in values){ if(!values.hasOwnProperty(k)) continue; var ci=hdr.indexOf(k); if(ci<0 || ci===0) continue; if(tf[ci]) continue; var val=values[k]; if(val===''||val==null) continue;
      if(WA_LINK[k]){ sh.getRange(row,ci+1).setFormula(waLinkF_(WA_LINK[k],val)); }
      else { sh.getRange(row,ci+1).setValue(waCoerce_(k,val)); }
    }
    var rules=WA_STAMP[code];
    if(rules){ for(var ri=0;ri<rules.length;ri++){ var rule=rules[ri]; var tv=values[rule[0]]; if(tv==null||tv==='') continue; var lc=String(tv).toLowerCase(); var ok=(rule[1][0]==='*'); for(var q=0;q<rule[1].length && !ok;q++){ if(lc.indexOf(rule[1][q])>=0) ok=true; } if(!ok) continue; var ti=hdr.indexOf(rule[2]); if(ti<0) continue; var tc=sh.getRange(row,ti+1); if(String(tc.getValue())==='') tc.setValue(new Date()); } }
    SpreadsheetApp.flush();
    return {ok:true, id:id, row:row, link:waLink(sh,row)};
  }catch(e){ return {ok:false, error:String(e&&e.message||e)}; }
  finally{ try{ lock.releaseLock(); }catch(e){} }
}

function waValidate_(values){
  for(var k in values){ if(!values.hasOwnProperty(k)) continue; var v=values[k]; if(v===''||v==null) continue;
    if(/phone/.test(k)){ if(!/^0\d{9,10}$/.test(String(v).replace(/\s/g,''))) return 'SDT khong hop le: '+k; }
    if(/(amount|fee|score|band)/.test(k) && !/_status$|_rate$/.test(k)){ var n=Number(String(v).replace(/[^0-9.\-]/g,'')); if(isNaN(n)||n<0) return 'So khong hop le: '+k; if(/band|score/.test(k)&&n>9) return 'Diem 0-9: '+k; }
  }
  return '';
}
function apiUpdate(code, id, values){
  var lock=LockService.getDocumentLock(); try{ lock.waitLock(20000); }catch(e){ return {ok:false, error:'He thong dang ban.'}; }
  try{
    if(!canWrite_(code)) return {ok:false,error:'Vai tro cua ban khong duoc phep sua muc nay (CH3).'};
    var v0=waValidate_(values); if(v0) return {ok:false, error:v0};
    var sh=waSheet(code+'.'); var lastCol=sh.getLastColumn(); var last=sh.getLastRow(); if(last<4) return {ok:false, error:'Sheet trong'};
    var hdr=sh.getRange(1,1,1,lastCol).getValues()[0].map(String);
    var tf=sh.getRange(4,1,1,lastCol).getFormulas()[0];
    var col=sh.getRange(4,1,last-3,1).getValues(); var row=-1;
    for(var i=0;i<col.length;i++){ if(String(col[i][0])===String(id)){ row=i+4; break; } }
    if(row<0) return {ok:false, error:'Khong thay '+id};
    for(var k in values){ if(!values.hasOwnProperty(k)) continue; var ci=hdr.indexOf(k); if(ci<0||ci===0) continue; if(tf[ci]) continue; var val=values[k];
      if(WA_LINK[k]){ if(val===''||val==null) sh.getRange(row,ci+1).setValue(''); else sh.getRange(row,ci+1).setFormula(waLinkF_(WA_LINK[k],val)); }
      else sh.getRange(row,ci+1).setValue((val===''||val==null)?'':waCoerce_(k,val));
    }
    var rules=WA_STAMP[code];
    if(rules){ for(var ri=0;ri<rules.length;ri++){ var rule=rules[ri]; var tv=values[rule[0]]; if(tv==null||tv==='') continue; var lc=String(tv).toLowerCase(); var ok=(rule[1][0]==='*'); for(var q=0;q<rule[1].length && !ok;q++){ if(lc.indexOf(rule[1][q])>=0) ok=true; } if(!ok) continue; var ti=hdr.indexOf(rule[2]); if(ti<0) continue; var tc=sh.getRange(row,ti+1); if(String(tc.getValue())==='') tc.setValue(new Date()); } }
    SpreadsheetApp.flush();
    return {ok:true, id:id, row:row, link:waLink(sh,row)};
  }catch(e){ return {ok:false, error:String(e&&e.message||e)}; }
  finally{ try{ lock.releaseLock(); }catch(e){} }
}
function apiApprove(enrollmentId, decision, staffId){
  if(PERM_ENFORCE && currentRole_()!=='manager') return {ok:false, error:'Chi Quan ly duoc duyet / hoan tien (CH3).'};
  var lock=LockService.getDocumentLock(); try{ lock.waitLock(20000); }catch(e){ return {ok:false, error:'He thong dang ban.'}; }
  try{
    var sh=waSheet('DL06.'); var lastCol=sh.getLastColumn(); var last=sh.getLastRow(); if(last<4) return {ok:false, error:'Sheet trong'};
    var hdr=sh.getRange(1,1,1,lastCol).getValues()[0].map(String);
    var v=sh.getRange(4,1,last-3,lastCol).getValues();
    var who=staffId||Session.getActiveUser().getEmail()||'manager';
    for(var i=0;i<v.length;i++){ if(String(v[i][0])===enrollmentId){ var row=i+4;
      function setc(h,val){ var c=hdr.indexOf(h); if(c>=0) sh.getRange(row,c+1).setValue(val); }
      function getc(h){ var c=hdr.indexOf(h); return c>=0? String(sh.getRange(row,c+1).getValue()) : ''; }
      if(decision==='approve'){ setc('discount_approved_by', who); if(getc('discount_approved_at')==='') setc('discount_approved_at', new Date()); }
      else if(decision==='reject'){ setc('discount_amount', 0); setc('discount_approved_by', 'Tu choi - '+who); if(getc('discount_approved_at')==='') setc('discount_approved_at', new Date()); var nt=getc('notes'); setc('notes', (nt?nt+' | ':'')+'CK bi tu choi boi '+who); }
      else if(decision==='refund'){ var n2=getc('notes'); setc('notes', (n2?n2+' | ':'')+'Da xu ly hoan tien '+(new Date()).toLocaleDateString()+' boi '+who); }
      SpreadsheetApp.flush(); return {ok:true, decision:decision};
    } }
    return {ok:false, error:'Khong thay '+enrollmentId};
  }catch(e){ return {ok:false, error:String(e&&e.message||e)}; }
  finally{ try{ lock.releaseLock(); }catch(e){} }
}

function apiAttendanceSave(sessionId, records){
  if(PERM_ENFORCE && !canWrite_('DL12')) return {ok:false, error:'Vai tro cua ban khong duoc phep diem danh (CH3).'};
  try{
    var sh=waSheet('DL12.'); var lastCol=sh.getLastColumn(); var last=sh.getLastRow();
    var hdr=sh.getRange(1,1,1,lastCol).getValues()[0].map(String);
    var iSess=hdr.indexOf('session_id'), iStu=hdr.indexOf('student_id'), iStat=hdr.indexOf('attendance_status'), iCheck=hdr.indexOf('check_in_time');
    var iAbs=hdr.indexOf('absence_type'), iPerf=hdr.indexOf('in_class_performance'), iNote=hdr.indexOf('note');
    var enumA=[]; try{ enumA=waSS().getRangeByName('enum_attendance_status').getValues().map(function(r){return String(r[0])}); }catch(e){}
    function full(cd){ for(var i=0;i<enumA.length;i++){ if(enumA[i].indexOf(cd)===0) return enumA[i]; } return cd; }
    var map={}; if(last>=4){ var disp=sh.getRange(4,1,last-3,lastCol).getDisplayValues(); for(var i=0;i<disp.length;i++){ var kk=String(disp[i][iStu])+'|'+String(disp[i][iSess]); map[kk]=i+4; } }
    var nameMap={}; var d9=readSheet_('DL09'); for(var j=0;j<d9.length;j++){ nameMap[d9[j].student_id]=d9[j].full_name; }
    var upd=0, ins=0;
    for(var r=0;r<records.length;r++){ var rec=records[r]; var key=String(rec.student_id)+'|'+String(sessionId); var stFull=full(rec.attendance_status);
      if(map[key]){ var row=map[key]; if(iStat>=0) sh.getRange(row,iStat+1).setValue(stFull);
        if(iAbs>=0) sh.getRange(row,iAbs+1).setValue(rec.absence_type||'');
        if(iPerf>=0 && rec.performance) sh.getRange(row,iPerf+1).setValue(rec.performance);
        if(iNote>=0 && rec.note!==undefined) sh.getRange(row,iNote+1).setValue(rec.note||'');
        if(iCheck>=0){ if(/on_time|late/.test(rec.attendance_status)){ if(String(sh.getRange(row,iCheck+1).getValue())==='') sh.getRange(row,iCheck+1).setValue(new Date()); } else { sh.getRange(row,iCheck+1).setValue(''); } }
        upd++; }
      else { var res=apiSave('DL12', { session_id:sessionId, student_id:rec.student_id, student_name:nameMap[rec.student_id]||'', attendance_status:stFull, absence_type:rec.absence_type||'', in_class_performance:rec.performance||'', note:rec.note||'', check_in_time:(/on_time|late/.test(rec.attendance_status)?new Date():'') }); if(res&&res.ok) ins++; }
    }
    SpreadsheetApp.flush();
    return {ok:true, updated:upd, inserted:ins};
  }catch(e){ return {ok:false, error:String(e&&e.message||e)}; }
}


