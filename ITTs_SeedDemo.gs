/**
 * ITTs - SEED DEMO DATA  v3  (AN TOÀN)
 * =====================================================================
 * NGUYÊN TẮC: script này CHỈ THÊM DỮ LIỆU vào các cột nhập.
 *   KHÔNG xóa dòng, KHÔNG đổi kích thước lưới, KHÔNG sửa công thức của anh,
 *   KHÔNG đụng cột mã (HYPERLINK), KHÔNG gỡ Kiểm tra dữ liệu.
 *   -> Không thể làm hỏng cấu trúc file. Trước khi ghi còn TỰ SAO LƯU 1 bản.
 *
 * ---------------------------------------------------------------------
 * DÙNG NHƯ THẾ NÀO (nên chạy trên BẢN SAO trước: Tệp > Tạo bản sao)
 *
 *   seedDemo()        Bơm demo vào các dòng trống. Chỉ thêm mã CHƯA có
 *                     -> chạy lại bao nhiêu lần cũng không nhân đôi.
 *                     Lần đầu để DRY_RUN=true xem báo cáo, rồi đổi false để ghi thật.
 *
 *   clearDemoData()   Xóa NỘI DUNG các dòng dữ liệu (giữ nguyên lưới, công thức,
 *                     định dạng, kiểm tra dữ liệu). Dùng khi muốn thay demo cũ.
 *
 *   resetDemo()       = sao lưu + clearDemoData + seedDemo. Làm mới phiên test,
 *                     MỌI MỐC THỜI GIAN TỰ DỜI VỀ HÔM NAY.
 *
 *   seedDoctor()      CHỈ ĐỌC, không sửa gì. Khám mọi cột và báo chỗ nào trống/lỗi.
 *
 * ---------------------------------------------------------------------
 * 2 CÔNG CỤ CẢI TẠO FILE - TÁCH RIÊNG, CHỈ CHẠY KHI ANH CHỦ ĐỘNG MUỐN:
 *
 *   widenTemplateRanges()  Công thức của template chỉ dò tới dòng 300/500/1000.
 *                          Dữ liệu nhiều hơn thì phần dư không được tính.
 *                          Hàm này nới lên 3000 và thêm dòng lưới cho đủ.
 *                          => SỬA CÔNG THỨC GỐC. Chạy trên bản sao trước.
 *
 *   flattenIdLinks()       Cột mã đang là HYPERLINK() nên COUNTIF/VLOOKUP dò
 *                          theo mã không khớp. Hàm này đổi cột mã về text thường
 *                          (mất link bấm nhảy). Có kiểm tra an toàn: ô nào đang
 *                          trống/lỗi thì BỎ QUA cả cột, không ghi đè.
 *                          => SỬA DỮ LIỆU GỐC. Chạy trên bản sao trước.
 *
 * Lưu ý: ngày sinh (dob) không bị dời; các ngày khác - kể cả ngày nằm trong
 * text ghi chú/lịch sử - dời cùng một khoảng nên câu chuyện demo giữ nguyên.
 */

var DRY_RUN     = true;    // true = chỉ báo cáo, chưa ghi. resetDemo() bỏ qua cờ này.
var AUTO_BACKUP = true;    // tự tạo bản sao file trước khi ghi/xóa
var SEED_ANCHOR = '21/07/2026';
var SEED_ORDER  = ['DL01','DL05','DL10','DL11','DL02','DL09','DL06','DL07','DL08','DL03','DL04','DL02b','DL12','DL13','DL14','DL15','DL16','DL17','DL18'];
var ADD_COLS    = { DL02:['handover_return_to','handover_until'], DL08:['class_info_sent_at'] };
var FORCE_WRITE = false;
var AUTO_FIX_DERIVED = true;  // sau khi bơm xong, tự điền các cột tính toán còn trống

/* ================= SAO LƯU ================= */
function backupNow_(){
  if(!AUTO_BACKUP) return '';
  try{
    var f  = DriveApp.getFileById(SpreadsheetApp.getActive().getId());
    var ts = Utilities.formatDate(new Date(), Session.getScriptTimeZone()||'Asia/Ho_Chi_Minh', 'dd-MM-yyyy HH:mm');
    var cp = f.makeCopy('[SAO LƯU '+ts+'] '+f.getName());
    return cp.getName();
  }catch(e){ return 'KHÔNG SAO LƯU ĐƯỢC: '+(e&&e.message||e); }
}

/* ================= NGÀY THÁNG ================= */
function seedDelta_(){
  var m=SEED_ANCHOR.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/); if(!m) return 0;
  var a=new Date(+m[3], +m[2]-1, +m[1]);
  var t=new Date(); t=new Date(t.getFullYear(), t.getMonth(), t.getDate());
  return Math.round((t.getTime()-a.getTime())/86400000);
}
function shiftDates_(h, v, delta){
  if(delta===0 || v==null || v==='' || h==='dob') return v;
  return String(v).replace(/(\d{1,2})\/(\d{1,2})\/(\d{4})/g, function(_,dd,mm,yy){
    var d=new Date(+yy, +mm-1, +dd); d.setDate(d.getDate()+delta);
    function p(n){return n<10?'0'+n:''+n}
    return p(d.getDate())+'/'+p(d.getMonth()+1)+'/'+d.getFullYear();
  });
}

/* ================= TIỆN ÍCH SHEET ================= */
function seedFindSheet_(pfx){
  var shs = SpreadsheetApp.getActive().getSheets();
  for(var i=0;i<shs.length;i++){ if(shs[i].getName().indexOf(pfx)===0) return shs[i]; }
  throw new Error('Không tìm thấy sheet '+pfx);
}
function seedParseVN_(v){
  var m = String(v).match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:\s+(\d{1,2}):(\d{2}))?/);
  if(!m) return null;
  return new Date(+m[3], +m[2]-1, +m[1], m[4]?+m[4]:0, m[5]?+m[5]:0);
}
function seedCoerce_(h, v){
  if(v==='' || v==null) return '';
  if(/_time$|_date$|_at$|^dob$/.test(h)){ var d = seedParseVN_(v); return d || v; }
  if(/_status$|_rate$|_name$|_type$|_id$/.test(h)) return v;
  if(/(amount|fee|score|band|nps|satisfaction|count|capacity|enrollment$|quota)/.test(h)
     || /^skill_|^final_(listening|reading|writing|speaking)$|^teacher_late_minutes$|^session_number$/.test(h)){
    var s = String(v).replace(/[^0-9.\-]/g,'');
    if(s!=='' && !isNaN(Number(s))) return Number(s);
  }
  return v;
}
function isSpillFormula_(f){
  // vùng mở kiểu A4:A -> công thức mảng tự trải (giữ 1 bản chủ).
  // ARRAYFORMULA vùng đóng (ref 1 ô) là công thức chép xuống từng dòng.
  return /\$?[A-Z]{1,2}\$?[0-9]+:\$?[A-Z]{1,2}(?![0-9A-Za-z$])/.test(f);
}
function colKind_(f){
  if(!f) return 'input';
  if(f.toUpperCase().indexOf('ARRAYFORMULA')>=0) return isSpillFormula_(f) ? 'arraymaster' : 'formula';
  if(f.indexOf('HYPERLINK(')>=0) return 'link';
  return 'formula';
}
function ensureCols_(code, sh, hdr, dry){
  var want = ADD_COLS[code] || []; var added = [];
  for(var i=0;i<want.length;i++){
    var w = want[i];
    if(hdr.indexOf(w) >= 0) continue;
    added.push(w);
    if(!dry){ sh.getRange(1, hdr.length+1).setValue(w); hdr.push(w); }
  }
  return added;
}

/* ================= GHI DEMO (CHỈ THÊM) ================= */
function seedSheet_(code, allRows){
  var sh = seedFindSheet_(code+'.');
  var lastCol = sh.getLastColumn();
  var hdr = sh.getRange(1,1,1,lastCol).getValues()[0].map(String);
  while(hdr.length && hdr[hdr.length-1]==='') hdr.pop();
  var dry = (DRY_RUN && !FORCE_WRITE);
  var addedCols = ensureCols_(code, sh, hdr, dry);
  lastCol = hdr.length;
  var warn = [];
  if(!allRows || !allRows.length) return {n:0, cols:addedCols, warn:warn};

  var pk = hdr[0];
  var maxR = sh.getMaxRows();
  var colA = sh.getRange(4,1,Math.max(1,maxR-3),1).getValues();
  var existing = {}, start = -1;
  for(var i=0;i<colA.length;i++){
    var v = String(colA[i][0]);
    if(v!=='') existing[v] = 1;
    else if(start<0) start = i+4;
  }
  if(start<0) start = maxR+1;

  var newRows = [];
  for(var r=0;r<allRows.length;r++){
    var id = String(allRows[r][pk]||'');
    if(id && !existing[id]) newRows.push(allRows[r]);
  }
  var n = newRows.length;
  if(n===0 || dry) return {n:n, cols:addedCols, warn:warn};

  var delta = seedDelta_();
  // chỉ THÊM dòng lưới nếu thiếu chỗ cho dữ liệu (không bao giờ xóa dòng)
  var need = start + n - 1;
  if(need > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), need - sh.getMaxRows() + 5);

  // phân loại cột theo công thức ở dòng mẫu (dòng 4)
  var f4 = sh.getRange(4,1,1,lastCol).getFormulas()[0];
  var kind = [];
  for(var k=0;k<lastCol;k++) kind.push(colKind_(f4[k]||''));
  kind[0] = 'input';

  // clone dòng mẫu: công thức + định dạng + kiểm tra dữ liệu (đúng như dòng mẫu của anh)
  sh.getRange(4,1,1,lastCol).copyTo(sh.getRange(start,1,n,lastCol));

  // công thức mảng TỰ TRẢI chỉ được có 1 bản chủ -> dọn bản clone bên dưới
  for(var ca=0;ca<lastCol;ca++){
    if(kind[ca]!=='arraymaster') continue;
    var from = Math.max(start,5), to = start+n-1;
    if(to>=from) sh.getRange(from,ca+1,to-from+1,1).clearContent();
  }

  function cellVal(rIdx,cIdx){
    var h = hdr[cIdx]; if(!h) return '';
    return seedCoerce_(h, shiftDates_(h, newRows[rIdx][h], delta));
  }
  function blockFor(c1,c2){
    var out=[];
    for(var r2=0;r2<n;r2++){ var row=[]; for(var cc=c1;cc<=c2;cc++) row.push(cellVal(r2,cc)); out.push(row); }
    return out;
  }
  // giữ số 0 đứng đầu (SĐT, Zalo): ép định dạng CHỮ cho ĐÚNG vùng sắp ghi
  for(var cf=0;cf<lastCol;cf++){
    if(kind[cf]!=='input') continue;
    var hf=hdr[cf]; if(!hf) continue;
    var needText=false;
    for(var rf=0; rf<n && rf<40; rf++){ var vf=newRows[rf][hf]; if(typeof vf==='string' && /^0[0-9]{5,}$/.test(vf)){ needText=true; break; } }
    if(needText){ try{ sh.getRange(start,cf+1,n,1).setNumberFormat('@'); }catch(eF){} }
  }

  // ghi 1 cột (có đường lùi: nếu Kiểm tra dữ liệu chặn thì tạm gỡ ĐÚNG cột đó rồi gắn lại)
  function writeCol(c){
    var rg = sh.getRange(start, c+1, n, 1);
    try{ rg.setValues(blockFor(c,c)); SpreadsheetApp.flush(); return ''; }
    catch(e1){
      var msg = (e1&&e1.message||e1);
      var dv = null;
      try{ dv = sh.getRange(4,c+1).getDataValidation(); rg.clearDataValidations(); }catch(e2){}
      try{
        rg.setValues(blockFor(c,c)); SpreadsheetApp.flush();
        if(dv){ try{ rg.setDataValidation(dv); }catch(e3){} }
        return hdr[c]+': dữ liệu không qua được Kiểm tra dữ liệu ('+msg+') - đã ghi và gắn lại luật';
      }catch(e4){
        if(dv){ try{ rg.setDataValidation(dv); }catch(e5){} }
        return hdr[c]+': GHI KHÔNG ĐƯỢC - '+(e4&&e4.message||e4);
      }
    }
  }

  // ghi theo khối cột nhập liền kề cho nhanh; hỏng khối nào thì lùi về ghi từng cột
  var c=0;
  while(c<lastCol){
    if(kind[c]!=='input'){ c++; continue; }
    var c2=c; while(c2+1<lastCol && kind[c2+1]==='input') c2++;
    var ok=true;
    try{ sh.getRange(start, c+1, n, c2-c+1).setValues(blockFor(c,c2)); SpreadsheetApp.flush(); }
    catch(eB){ ok=false; }
    if(!ok){ for(var cx=c;cx<=c2;cx++){ var w=writeCol(cx); if(w) warn.push(w); } }
    c = c2+1;
  }

  // đối chiếu lại: cột nào có dữ liệu nguồn mà đọc lại rỗng -> ghi lại 1 lần
  var back = sh.getRange(start,1,n,lastCol).getDisplayValues();
  for(var cv=0;cv<lastCol;cv++){
    if(kind[cv]!=='input') continue;
    var h2 = hdr[cv]; if(!h2) continue;
    var want=0, got=0;
    for(var rv=0;rv<n;rv++){
      if(String(newRows[rv][h2]==null?'':newRows[rv][h2]).trim()!=='') want++;
      if(String(back[rv][cv]).trim()!=='') got++;
    }
    if(want>0 && got===0){ var w2=writeCol(cv); warn.push(w2 || (h2+': đã ghi lại thành công')); }
  }
  return {n:n, cols:addedCols, warn:warn};
}

function seedDemo(){
  var dry = (DRY_RUN && !FORCE_WRITE);
  var data = readDataset_();
  var report = [];
  if(!dry && AUTO_BACKUP && !FORCE_WRITE){ var b=backupNow_(); if(b) report.push('Đã sao lưu: '+b); }
  var startT = new Date().getTime();
  for(var i=0;i<SEED_ORDER.length;i++){
    var code = SEED_ORDER[i];
    var rows = (data.dl && data.dl[code]) ? data.dl[code] : [];
    try{
      var r = seedSheet_(code, rows);
      report.push((dry?'[thử] ':'')+code+': '+r.n+' dòng '+(dry?'sẽ thêm':'đã ghi')
        + (r.cols.length?(' | cột mới: '+r.cols.join(', ')):'')
        + ((r.warn&&r.warn.length)?('\n     - '+r.warn.join('\n     - ')):''));
    }catch(e){ report.push('LỖI '+code+': '+(e && e.message || e)); }
    if(new Date().getTime()-startT > 300000){ report.push('... tạm dừng (gần 6 phút) - chạy lại seedDemo() để làm tiếp.'); break; }
  }
  if(!dry && AUTO_FIX_DERIVED){
    try{ var fx=fixDerivedColumns(true); report.push('Đã điền '+fx.cells+' ô cột tính toán còn trống/lỗi.'); }
    catch(eFx){ report.push('Không điền được cột tính toán: '+(eFx&&eFx.message||eFx)); }
  }
  var msg = (dry ? 'CHẠY THỬ - CHƯA GHI GÌ. Đổi DRY_RUN=false rồi chạy lại để ghi thật.\n\n'
                 : 'ĐÃ GHI XONG (mốc thời gian dời '+seedDelta_()+' ngày về hiện tại).\n\n') + report.join('\n');
  Logger.log(msg); try{ SpreadsheetApp.getUi().alert(msg); }catch(e){}
}

/* ================= XÓA NỘI DUNG DEMO (giữ nguyên lưới + công thức) ================= */
function clearDemoData(){
  var ui=null; try{ ui=SpreadsheetApp.getUi(); }catch(e){}
  if(ui){
    var a=ui.alert('XÓA NỘI DUNG DỮ LIỆU?','Xóa nội dung các dòng dữ liệu của '+SEED_ORDER.length+' sheet DL.\nGIỮ NGUYÊN: lưới, công thức dòng mẫu, định dạng, kiểm tra dữ liệu.\nTiếp tục?',ui.ButtonSet.YES_NO);
    if(a!==ui.Button.YES){ ui.alert('Đã hủy.'); return; }
  }
  clearCore_(true);
}
function clearCore_(showAlert){
  var rep=[];
  if(AUTO_BACKUP){ var b=backupNow_(); if(b) rep.push('Đã sao lưu: '+b); }
  for(var i=0;i<SEED_ORDER.length;i++){
    var code=SEED_ORDER[i];
    try{
      var sh=seedFindSheet_(code+'.');
      var lastCol=sh.getLastColumn(), last=sh.getLastRow();
      // 1) xóa NỘI DUNG từ dòng 5 trở đi (không xóa dòng -> lưới không đổi)
      if(last>4) sh.getRange(5,1,last-4,lastCol).clearContent();
      // 2) dòng 4 là dòng mẫu: chỉ xóa ô KHÔNG có công thức
      var f4=sh.getRange(4,1,1,lastCol).getFormulas()[0];
      var vals=sh.getRange(4,1,1,lastCol).getValues()[0];
      var cleared=0;
      for(var c=0;c<lastCol;c++){
        if(f4[c]) continue;
        if(String(vals[c])!==''){ sh.getRange(4,c+1).clearContent(); cleared++; }
      }
      rep.push(code+': xóa nội dung '+Math.max(0,last-4)+' dòng + '+cleared+' ô ở dòng mẫu');
    }catch(e){ rep.push('LỖI '+code+': '+(e&&e.message||e)); }
  }
  SpreadsheetApp.flush();
  var msg='ĐÃ XÓA NỘI DUNG (lưới & công thức giữ nguyên).\n\n'+rep.join('\n');
  Logger.log(msg);
  if(showAlert){ try{ SpreadsheetApp.getUi().alert(msg+'\n\nGiờ chạy seedDemo() để bơm demo mới.'); }catch(e){} }
}

function resetDemo(){
  var ui=null; try{ ui=SpreadsheetApp.getUi(); }catch(e){}
  if(ui){
    var a=ui.alert('LÀM MỚI PHIÊN TEST?','Sao lưu file -> xóa nội dung demo cũ -> bơm demo mới,\nmọi mốc thời gian dời về hôm nay (dời '+seedDelta_()+' ngày).\nKhông xóa dòng, không sửa công thức.\nTiếp tục?',ui.ButtonSet.YES_NO);
    if(a!==ui.Button.YES){ ui.alert('Đã hủy.'); return; }
  }
  clearCore_(false);
  FORCE_WRITE=true;
  try{ seedDemo(); } finally { FORCE_WRITE=false; }
}

/* ================= KHÁM (CHỈ ĐỌC - KHÔNG SỬA GÌ) ================= */
function seedDoctor(){
  var NL=String.fromCharCode(10);
  var rep=[], problems=0;
  for(var i=0;i<SEED_ORDER.length;i++){
    var code=SEED_ORDER[i];
    try{
      var sh=seedFindSheet_(code+'.');
      var lastCol=sh.getLastColumn(), last=sh.getLastRow(), maxR=sh.getMaxRows();
      var hdr=sh.getRange(1,1,1,lastCol).getValues()[0].map(String);
      while(hdr.length && hdr[hdr.length-1]==='') hdr.pop();
      lastCol=hdr.length;
      var f4=sh.getRange(4,1,1,lastCol).getFormulas()[0];
      var kind=[], capped=[];
      for(var c=0;c<lastCol;c++){
        var f=f4[c]||''; kind.push(colKind_(f));
        var m=f.match(/\$?[A-Z]{1,3}\$?(300|500|1000)(?![0-9])/);
        if(m) capped.push(hdr[c]+' (tới dòng '+m[1]+')');
      }
      kind[0]='input';
      var nData=Math.max(0,last-3);
      var line=code+': '+nData+' dòng (lưới '+maxR+')';
      if(nData>0){
        var vals=sh.getRange(4,1,nData,lastCol).getDisplayValues();
        var emptyIn=[], emptyF=[], onlyFirst=[], errs=[], low=[], linkCols=[];
        for(var c2=0;c2<lastCol;c2++){
          var h=hdr[c2]; if(!h) continue;
          if(kind[c2]==='link') linkCols.push(h);
          var ne=0, ner=0, neBelow=0;
          for(var r=0;r<nData;r++){
            var v=String(vals[r][c2]).trim();
            if(v!==''){ ne++; if(r>0) neBelow++; }
            if(v.indexOf('#REF')===0||v.indexOf('#N/A')===0||v.indexOf('#ERROR')===0||v.indexOf('#VALUE')===0) ner++;
          }
          var isF=(kind[c2]==='formula'||kind[c2]==='arraymaster');
          if(ner>0){ errs.push(h+' ('+ner+' lỗi)'); continue; }
          if(ne===0){ if(isF) emptyF.push(h); else emptyIn.push(h); continue; }
          if(isF && nData>3 && neBelow===0){ onlyFirst.push(h); continue; }
          var pct=Math.round(ne*100/nData);
          if(pct<10) low.push(h+' '+pct+'%');
        }
        if(errs.length){      line+=NL+'   [!] LỖI CÔNG THỨC: '+errs.join(', '); problems++; }
        if(onlyFirst.length){ line+=NL+'   [!] CHỈ CÓ DÒNG ĐẦU: '+onlyFirst.join(', '); problems++; }
        if(emptyF.length){    line+=NL+'   [!] CÔNG THỨC TRỐNG: '+emptyF.join(', '); problems++; }
        if(emptyIn.length){   line+=NL+'   [!] CỘT NHẬP TRỐNG: '+emptyIn.join(', '); problems++; }
        if(capped.length && nData>290){ line+=NL+'   (công thức chỉ dò tới dòng cố định: '+capped.join(', ')+' - muốn phủ hết thì chạy widenTemplateRanges())'; }
        if(linkCols.length && (onlyFirst.length||emptyF.length)){ line+=NL+'   (cột mã đang là HYPERLINK: '+linkCols.join(', ')+' - có thể là lý do công thức dò mã không khớp; xem flattenIdLinks())'; }
        if(low.length){       line+=NL+'   (thấp - chỉ dòng có tình huống đó mới có: '+low.join(', ')+')'; }
        if(!errs.length&&!onlyFirst.length&&!emptyF.length&&!emptyIn.length) line+=NL+'   OK - mọi cột đều có dữ liệu';
      }
      rep.push(line);
    }catch(e){ rep.push('LỖI '+code+': '+(e&&e.message||e)); problems++; }
  }
  var head = problems ? ('PHÁT HIỆN '+problems+' VẤN ĐỀ (xem chi tiết bên dưới)') : 'TẤT CẢ ỔN - không cột nào trống bất thường.';
  var msg='KHÁM SỨC KHỎE DỮ LIỆU (chỉ đọc, không sửa gì)'+NL+head+NL+NL+rep.join(NL);
  Logger.log(msg); try{ SpreadsheetApp.getUi().alert(msg); }catch(e){}
  return msg;
}

/* ================= 2 CÔNG CỤ CẢI TẠO - CHỈ CHẠY KHI CHỦ ĐỘNG MUỐN ================= */
function widenTemplateRanges(){
  var ui=null; try{ ui=SpreadsheetApp.getUi(); }catch(e){}
  if(ui){
    var a=ui.alert('SỬA CÔNG THỨC CỦA TEMPLATE?','Nới vùng dò của công thức từ 300/500/1000 lên 3000 và thêm dòng lưới cho đủ.\nĐÂY LÀ SỬA CÔNG THỨC GỐC - nên làm trên BẢN SAO.\nTiếp tục?',ui.ButtonSet.YES_NO);
    if(a!==ui.Button.YES){ ui.alert('Đã hủy.'); return; }
  }
  var rep=[]; if(AUTO_BACKUP){ var b=backupNow_(); if(b) rep.push('Đã sao lưu: '+b); }
  for(var i=0;i<SEED_ORDER.length;i++){
    var code=SEED_ORDER[i];
    try{
      var sh=seedFindSheet_(code+'.');
      var m=sh.getMaxRows(); if(m<3050) sh.insertRowsAfter(m, 3050-m);
      var lastCol=sh.getLastColumn(), last=sh.getLastRow();
      var fs=sh.getRange(4,1,1,lastCol).getFormulas()[0];
      var nfix=0;
      for(var c=0;c<lastCol;c++){
        var f=fs[c]; if(!f) continue;
        var nf=f.replace(/(\$?[A-Z]{1,3}\$?)(300|500|1000)(?![0-9])/g, function(mm,pre,num){ return pre+'3000'; });
        if(nf!==f){
          sh.getRange(4,c+1).setFormula(nf);
          if(last>4 && colKind_(f)!=='arraymaster') sh.getRange(4,c+1).copyTo(sh.getRange(5,c+1,last-4,1));
          nfix++;
        }
      }
      rep.push(code+': nới '+nfix+' công thức');
    }catch(e){ rep.push('LỖI '+code+': '+(e&&e.message||e)); }
  }
  try{ SpreadsheetApp.flush(); }catch(e){}
  var msg='ĐÃ NỚI VÙNG CÔNG THỨC.\n\n'+rep.join('\n');
  Logger.log(msg); try{ SpreadsheetApp.getUi().alert(msg); }catch(e){}
}

function flattenIdLinks(){
  var ui=null; try{ ui=SpreadsheetApp.getUi(); }catch(e){}
  if(ui){
    var a=ui.alert('ĐỔI CỘT MÃ THÀNH TEXT?','Cột mã đang là HYPERLINK() nên COUNTIF/VLOOKUP dò theo mã không khớp\n(first_call_time, attendance_rate... bị rỗng).\nHàm này đổi các cột đó về text thường - MẤT link bấm nhảy.\nCột nào có ô trống/lỗi sẽ được BỎ QUA để không mất dữ liệu.\nNên làm trên BẢN SAO. Tiếp tục?',ui.ButtonSet.YES_NO);
    if(a!==ui.Button.YES){ ui.alert('Đã hủy.'); return; }
  }
  var rep=[]; if(AUTO_BACKUP){ var b=backupNow_(); if(b) rep.push('Đã sao lưu: '+b); }
  for(var i=0;i<SEED_ORDER.length;i++){
    var code=SEED_ORDER[i];
    try{
      var sh=seedFindSheet_(code+'.');
      var lastCol=sh.getLastColumn(), last=sh.getLastRow(), n=last-3;
      if(n<1){ rep.push(code+': không có dữ liệu'); continue; }
      var hdr=sh.getRange(1,1,1,lastCol).getValues()[0].map(String);
      var f4=sh.getRange(4,1,1,lastCol).getFormulas()[0];
      var done=[], skip=[];
      for(var c=0;c<lastCol;c++){
        if(String(f4[c]||'').indexOf('HYPERLINK(')<0) continue;
        var disp=sh.getRange(4,c+1,n,1).getDisplayValues();
        var bad=0;
        for(var r=0;r<n;r++){
          var v=String(disp[r][0]).trim();
          if(v===''||v.charAt(0)==='#') bad++;
        }
        if(bad>0){ skip.push(hdr[c]+' ('+bad+' ô trống/lỗi)'); continue; }   // AN TOÀN: không ghi đè
        for(var r2=0;r2<n;r2++) disp[r2][0]=String(disp[r2][0]);
        sh.getRange(4,c+1,n,1).setValues(disp);
        done.push(hdr[c]);
      }
      rep.push(code+': đổi '+(done.length?done.join(', '):'(không có)')+(skip.length?(' | BỎ QUA: '+skip.join(', ')):''));
    }catch(e){ rep.push('LỖI '+code+': '+(e&&e.message||e)); }
  }
  try{ SpreadsheetApp.flush(); }catch(e){}
  var msg='ĐÃ ĐỔI CỘT MÃ VỀ TEXT.\n\n'+rep.join('\n')+'\n\nChạy seedDoctor() để xem công thức đã tính ra chưa.';
  Logger.log(msg); try{ SpreadsheetApp.getUi().alert(msg); }catch(e){}
}


/* =====================================================================
 *  FIX CÁC CỘT TÍNH TOÁN  (gộp chung vào đây)
 *  Điền giá trị cho cột dẫn xuất đang TRỐNG hoặc LỖI: first_call_time,
 *  last_contact_time, contact_count, final_fee, paid_amount, remaining_amount,
 *  attendance_rate, completion_rate, wow_quota_*, current_enrollment, *_name...
 *  Tự tính bằng JavaScript (không dùng COUNTIF/VLOOKUP) nên KHÔNG lệ thuộc
 *  cột mã là HYPERLINK hay vùng công thức bị chặn.
 *  CHỈ ghi vào ô trống/lỗi - ô nào công thức đang chạy đúng thì GIỮ NGUYÊN.
 *  Chạy riêng:  fixDerivedColumns()   (theo cờ DRY_RUN)
 *  Tự chạy sau seedDemo/resetDemo khi AUTO_FIX_DERIVED = true.
 * ===================================================================== */


/* id -> [sheet chứa, cột tên] */
var REF = {
  student_id:['DL09','full_name'], lead_id:['DL02','full_name'], class_id:['DL10','class_name'],
  course_id:['DL05','course_name'], staff_id:['DL01','full_name'], teacher_id:['DL01','full_name'],
  assigned_to:['DL01','full_name'], main_teacher_id:['DL01','full_name'],
  received_by:['DL01','full_name'], verified_by:['DL01','full_name'], graded_by:['DL01','full_name'],
  assigned_handler:['DL01','full_name'], consulted_by:['DL01','full_name'], assigned_by:['DL01','full_name']
};

/* ================== TIỆN ÍCH ================== */
function fdFind_(pfx){ try{ return seedFindSheet_(pfx); }catch(e){ return null; } }

function fdIsBad_(v){                       // ô coi như "chưa có dữ liệu"
  var s = String(v==null?'':v).trim();
  return s==='' || s.charAt(0)==='#';
}
function fdNum_(v){
  if(v==null||v==='') return 0;
  var n = parseFloat(String(v).replace(/[^0-9.\-]/g,''));
  return isNaN(n)?0:n;
}
function fdDate_(v){                        // "dd/mm/yyyy hh:mm" | "yyyy-mm-dd hh:mm" | Date
  if(v instanceof Date) return v;
  var s = String(v==null?'':v).trim(); if(!s) return null;
  var m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:[ ,]+(\d{1,2}):(\d{2}))?/);
  if(m) return new Date(+m[3],+m[2]-1,+m[1], m[4]?+m[4]:0, m[5]?+m[5]:0);
  m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T]+(\d{1,2}):(\d{2}))?/);
  if(m) return new Date(+m[1],+m[2]-1,+m[3], m[4]?+m[4]:0, m[5]?+m[5]:0);
  var d = new Date(s); return isNaN(d.getTime())?null:d;
}
function fdCode_(v){                        // "new (Chưa liên hệ)" -> "new"
  return String(v==null?'':v).trim().split(' ')[0].toLowerCase();
}

/* Đọc 1 sheet: tiêu đề + giá trị hiển thị (nên cột mã dù là HYPERLINK vẫn ra text) */
function fdRead_(code){
  var sh = fdFind_(code+'.'); if(!sh) return null;
  var lastCol = sh.getLastColumn(), last = sh.getLastRow();
  var hdr = sh.getRange(1,1,1,lastCol).getValues()[0].map(String);
  while(hdr.length && hdr[hdr.length-1]==='') hdr.pop();
  lastCol = hdr.length;
  var n = Math.max(0, last-3);
  var disp = n ? sh.getRange(4,1,n,lastCol).getDisplayValues() : [];
  var idx = {}; for(var c=0;c<lastCol;c++) idx[hdr[c]] = c;
  var recs = [];
  for(var r=0;r<n;r++){
    var o = {};
    for(var k in idx) o[k] = disp[r][idx[k]];
    o.__row = r; recs.push(o);
  }
  return {code:code, sh:sh, hdr:hdr, idx:idx, n:n, lastCol:lastCol, recs:recs};
}

/* Gom nhóm theo khóa */
function fdGroup_(t, key){
  var g = {}; if(!t) return g;
  for(var i=0;i<t.recs.length;i++){
    var k = String(t.recs[i][key]||'').trim(); if(!k) continue;
    (g[k] = g[k] || []).push(t.recs[i]);
  }
  return g;
}
function fdMap_(t, key, val){
  var m = {}; if(!t) return m;
  for(var i=0;i<t.recs.length;i++){
    var k = String(t.recs[i][key]||'').trim(); if(!k) continue;
    if(m[k]===undefined) m[k] = t.recs[i][val];
  }
  return m;
}

/* ================== HÀM CHÍNH ================== */
function fixDerivedColumns(force){
  var dryFix = (DRY_RUN && !force);
  var NL = String.fromCharCode(10);
  var T = {};                                  // đọc toàn bộ 1 lần
  for(var i=0;i<SEED_ORDER.length;i++) T[SEED_ORDER[i]] = fdRead_(SEED_ORDER[i]);

  var plan = {};                               // plan[code][cột] = { row -> giá trị }
  function put(code, col, row, val){
    if(!T[code] || T[code].idx[col]===undefined) return;
    if(val===null || val===undefined || val==='') return;
    if(!fdIsBad_(T[code].recs[row][col])) return;      // ô đang có dữ liệu đúng -> KHÔNG đụng
    plan[code] = plan[code] || {};
    plan[code][col] = plan[code][col] || {};
    plan[code][col][row] = val;
  }

  /* ---------- 1) Mọi cột *_name (tra cứu theo mã) ---------- */
  var nameSrc = {};
  for(var idk in REF){
    var m = REF[idk], tt = T[m[0]];
    if(!tt) continue;
    var pk = tt.hdr[0];
    nameSrc[idk] = fdMap_(tt, pk, m[1]);
  }
  function baseOf(col){
    var b = col.replace(/_name$/,'').replace(/_display$/,'');
    if(b==='student') b='student_id';
    if(b==='customer'||b==='customer_name') b='lead_id';
    if(b==='teacher') b='teacher_id';
    return b;
  }
  for(var ci=0;ci<SEED_ORDER.length;ci++){
    var code = SEED_ORDER[ci], t = T[code]; if(!t) continue;
    for(var c=0;c<t.hdr.length;c++){
      var col = t.hdr[c]; if(!/_name$|_name_display$/.test(col)) continue;
      var base = baseOf(col); if(!REF[base] || !nameSrc[base]) continue;
      if(t.idx[base]===undefined) continue;
      for(var r=0;r<t.n;r++){
        var id = String(t.recs[r][base]||'').trim(); if(!id) continue;
        put(code, col, r, nameSrc[base][id]||'');
      }
    }
  }

  /* ---------- 2) DL02: liên hệ đầu / cuối / số lần ---------- */
  if(T.DL02 && T.DL02b){
    var tpBy = fdGroup_(T.DL02b, 'lead_id');
    var pk2  = T.DL02.hdr[0];
    for(var r2=0;r2<T.DL02.n;r2++){
      var lid = String(T.DL02.recs[r2][pk2]||'').trim(); if(!lid) continue;
      var ts = (tpBy[lid]||[]).map(function(x){ return fdDate_(x.contact_time); })
                              .filter(function(d){ return !!d; })
                              .sort(function(a,b){ return a-b; });
      put('DL02','contact_count', r2, ts.length);
      if(ts.length){
        put('DL02','first_call_time',  r2, ts[0]);
        put('DL02','last_contact_time',r2, ts[ts.length-1]);
      }
    }
  }

  /* ---------- 3) DL06: học phí sau CK / đã thu / còn lại ---------- */
  if(T.DL06){
    var payBy = T.DL07 ? fdGroup_(T.DL07,'enrollment_id') : {};
    var pk6 = T.DL06.hdr[0];
    for(var r6=0;r6<T.DL06.n;r6++){
      var e = T.DL06.recs[r6], eid = String(e[pk6]||'').trim();
      var fee = fdNum_(e.total_fee) - fdNum_(e.discount_amount); if(fee<0) fee=0;
      put('DL06','final_fee', r6, fee);
      var paid = 0, ps = payBy[eid]||[];
      for(var p=0;p<ps.length;p++) paid += fdNum_(ps[p].amount);
      put('DL06','paid_amount', r6, paid);
      var fin = fdIsBad_(e.final_fee) ? fee : fdNum_(e.final_fee);
      var pd  = fdIsBad_(e.paid_amount) ? paid : fdNum_(e.paid_amount);
      put('DL06','remaining_amount', r6, Math.max(0, fin-pd));
    }
  }

  /* ---------- 4) DL09: đăng ký đầu, hoạt động gần nhất, quota WOW ---------- */
  if(T.DL09){
    var enrBy = T.DL06 ? fdGroup_(T.DL06,'student_id') : {};
    var attBy = T.DL12 ? fdGroup_(T.DL12,'student_id') : {};
    var wowBy = T.DL14 ? fdGroup_(T.DL14,'student_id') : {};
    var quotaOf = T.DL05 ? fdMap_(T.DL05, T.DL05.hdr[0], 'wow_quota_default') : {};
    var pk9 = T.DL09.hdr[0];
    for(var r9=0;r9<T.DL09.n;r9++){
      var s = T.DL09.recs[r9], sid = String(s[pk9]||'').trim(); if(!sid) continue;
      var es = (enrBy[sid]||[]).slice().sort(function(a,b){
        var da=fdDate_(a.enrollment_time), db=fdDate_(b.enrollment_time);
        return (da?da.getTime():0)-(db?db.getTime():0);
      });
      put('DL09','total_enrollments', r9, es.length);
      if(es.length){
        put('DL09','first_enrollment_id',   r9, es[0][T.DL06.hdr[0]]);
        var d0 = fdDate_(es[0].enrollment_time); if(d0) put('DL09','first_enrollment_date', r9, d0);
        var q = fdNum_(quotaOf[String(es[0].course_id||'').trim()]);
        if(q>0) put('DL09','wow_quota_default', r9, q);
      }
      var ck = (attBy[sid]||[]).map(function(a){ return fdDate_(a.check_in_time); })
                               .filter(function(d){ return !!d; })
                               .sort(function(a,b){ return a-b; });
      if(ck.length) put('DL09','last_learning_activity_time', r9, ck[ck.length-1]);
      var used = 0, ws = wowBy[sid]||[];
      for(var w=0;w<ws.length;w++){
        var qd = String(ws[w].quota_deducted||'').toLowerCase();
        if(qd.indexOf('yes')===0 || qd.indexOf('có')===0 || qd==='1') used++;
      }
      put('DL09','wow_quota_used', r9, used);
      var def = fdIsBad_(s.wow_quota_default) ? 0 : fdNum_(s.wow_quota_default);
      if(!def && es.length) def = fdNum_(quotaOf[String(es[0].course_id||'').trim()]);
      var rem = def + fdNum_(s.wow_extra_approved) + fdNum_(s.wow_extra_purchased) - used;
      put('DL09','wow_quota_remaining', r9, Math.max(0, rem));
    }
  }

  /* ---------- 5) DL18: chuyên cần + tỷ lệ nộp bài ---------- */
  if(T.DL18){
    var attBy2 = T.DL12 ? fdGroup_(T.DL12,'student_id') : {};
    var hwBy   = T.DL13 ? fdGroup_(T.DL13,'student_id') : {};
    for(var r18=0;r18<T.DL18.n;r18++){
      var sid2 = String(T.DL18.recs[r18].student_id||'').trim(); if(!sid2) continue;
      var as = attBy2[sid2]||[];
      if(as.length){
        var ok=0;
        for(var a=0;a<as.length;a++){ var st=fdCode_(as[a].attendance_status); if(st==='on_time'||st==='late') ok++; }
        put('DL18','attendance_rate', r18, Math.round(ok*100/as.length)+'%');
      }
      var hs = hwBy[sid2]||[];
      if(hs.length){
        var sub=0;
        for(var h=0;h<hs.length;h++) if(fdCode_(hs[h].homework_status).indexOf('submitted')===0) sub++;
        put('DL18','completion_rate', r18, Math.round(sub*100/hs.length)+'%');
      }
    }
  }

  /* ---------- 6) DL10: sĩ số hiện tại ---------- */
  if(T.DL10 && T.DL08){
    var cnt = {};
    for(var o=0;o<T.DL08.n;o++){
      var cid = String(T.DL08.recs[o].class_id||'').trim(); if(!cid) continue;
      cnt[cid] = (cnt[cid]||0)+1;
    }
    var pk10 = T.DL10.hdr[0];
    for(var r10=0;r10<T.DL10.n;r10++){
      var cid2 = String(T.DL10.recs[r10][pk10]||'').trim(); if(!cid2) continue;
      if(cnt[cid2]) put('DL10','current_enrollment', r10, cnt[cid2]);
    }
  }

  /* ---------- GHI ---------- */
  var report = [], totalCells = 0;
  if(!dryFix && AUTO_BACKUP && !force){ var b = backupNow_(); if(b) report.push('Đã sao lưu: '+b); }

  for(var ck2=0; ck2<SEED_ORDER.length; ck2++){
    var cd = SEED_ORDER[ck2]; if(!plan[cd]) continue;
    var t2 = T[cd], parts = [];
    for(var col2 in plan[cd]){
      var fills = plan[cd][col2], cnt2 = 0;
      for(var k2 in fills) cnt2++;
      if(!cnt2) continue;
      totalCells += cnt2; parts.push(col2+' ('+cnt2+')');
      if(dryFix) continue;
      var cIdx = t2.idx[col2] + 1;
      var rng  = t2.sh.getRange(4, cIdx, t2.n, 1);
      var cur  = rng.getValues(), fml = rng.getFormulas();
      var out  = [];
      for(var rr=0; rr<t2.n; rr++){
        if(fills[rr]!==undefined) out.push([ fills[rr] ]);          // ô cần điền
        else out.push([ fml[rr][0] ? fml[rr][0] : cur[rr][0] ]);    // giữ nguyên công thức/giá trị cũ
      }
      rng.setValues(out);
    }
    if(parts.length) report.push(cd+': '+parts.join(', '));
  }
  if(!dryFix){ try{ SpreadsheetApp.flush(); }catch(e){} }

  var head = dryFix
    ? ('CHẠY THỬ - CHƯA GHI GÌ. Sẽ điền '+totalCells+' ô. Đổi DRY_RUN = false rồi chạy lại để ghi thật.')
    : ('ĐÃ ĐIỀN '+totalCells+' ô. Ô nào công thức đang chạy đúng thì giữ nguyên công thức.');
  var msg = 'FIX CÁC CỘT TÍNH TOÁN'+NL+head+NL+NL+(report.length?report.join(NL):'Không có ô nào cần điền - mọi cột đều đã có dữ liệu.');
  Logger.log(msg);
  if(!force){ try{ SpreadsheetApp.getUi().alert(msg); }catch(e){} }
  return {msg:msg, cells:totalCells};
}

